// Firestore Security Rules for HydroInspect
// Paste into Firebase Console → Firestore Database → Rules, then Publish.
//
// These rules ensure each signed-in user can only read/write their own data.
// The Firebase API key in firebase-sync.js is NOT a secret — it identifies
// your project — but these rules are what actually prevent strangers from
// reading or writing to your database.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user workspace: /users/{uid}/...
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
